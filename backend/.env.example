# 服务监听
HOST=0.0.0.0
PORT=8000

# 日志
LOG_LEVEL=INFO
LOG_FILE=

# 数据库（默认 SQLite；切 MySQL/PG 用 mysql+aiomysql:// / postgresql+asyncpg://）
DB_URL=sqlite+aiosqlite:///./xiaozhi_fde_talk.db
DB_ECHO=false

# 部署模式
ENV=dev                            # dev / test / prod
SERVE_FRONTEND=true                # true=托管前端 SPA；false=纯 API

# JWT 算法（密钥由系统启动时自动生成并写入 DB，无需配置）
JWT_ALGORITHM=HS256

# admin 启动密码（必须显式设置，否则服务拒启；不要留空）
# 强度要求：≥ 8 位、UTF-8 字节数 ≤ 72（bcrypt 上限）、不能命中 password_policy.py 内置的弱密码黑名单
# 注意：弱密码表大小写不敏感，「Admin123456」与「admin123456」同样会被拒
# 示例值仅为占位，别原样用于任何真实环境
APP_ADMIN_PASSWORD=

# CORS 允许的来源（逗号分隔）。dev 环境留空也能跑（默认 http://localhost:5173），
# 但 prod 必须显式列白名单域名（如 https://talk.your-company.com），否则启动失败。
CORS_ORIGINS=http://localhost:5173
