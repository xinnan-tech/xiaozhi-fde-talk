shell-emulator=true
shamefully-hoist=true
enable-pre-post-scripts=false
strict-peer-dependencies=false

# 允许废弃依赖
allowedDeprecatedVersions.are-we-there-yet=*
allowedDeprecatedVersions.sourcemap-codec=*
allowedDeprecatedVersions.lodash.isequal=*
allowedDeprecatedVersions.domexception=*
allowedDeprecatedVersions.w3c-hr-time=*
allowedDeprecatedVersions.inflight=*
allowedDeprecatedVersions.npmlog=*
allowedDeprecatedVersions.rimraf=*
allowedDeprecatedVersions.stable=*
allowedDeprecatedVersions.gauge=*
allowedDeprecatedVersions.abab=*
allowedDeprecatedVersions.glob=*

# 跳过原生编译（pnpm v11: 已迁移到 pnpm-workspace.yaml 的 allowBuilds 字段）
# ignoredBuiltDependencies=@tailwindcss/oxide