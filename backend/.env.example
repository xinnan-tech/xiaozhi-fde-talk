# 服务监听
HOST=0.0.0.0
PORT=8000

# 日志
LOG_LEVEL=INFO
LOG_FILE=

# 数据库（默认 SQLite；切 MySQL/PG 用 mysql+aiomysql:// / postgresql+asyncpg://）
DB_URL=sqlite+aiosqlite:///./xiaozhi_fde_talk.db
DB_ECHO=false

# 部署模式
ENV=dev                            # dev / test / prod
SERVE_FRONTEND=true                # true=托管前端 SPA；false=纯 API

# JWT 算法（密钥由系统启动时自动生成并写入 DB，无需配置）
JWT_ALGORITHM=HS256

# CORS 允许的来源（逗号分隔）。
# dev 环境留空也能跑（默认 http://localhost:5173），PROD 必填：
# 列白名单域名（如 https://talk.your-company.com），否则启动失败（fail-fast）。
# 上公网前请显式覆盖此值，不要直接复制 dev 默认到生产。
# CORS_ORIGINS=
