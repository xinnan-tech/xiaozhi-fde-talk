# Dockerfile-server-base
# 基础镜像：python 运行时 + 系统依赖 + 后端 Python 包。仅在 backend/requirements.txt
# 或本文件变更时由 build-base-image.yml 重打；改后端业务代码不需要重打本镜像。
#
# 故意不带：ffmpeg / libopus / gcc / python3-dev。
# - 后端用 PyAV（av==12.3.0）做 WebM 解码，PyAV wheel 自带 FFmpeg 二进制，不需要系统 ffmpeg。
# - bcrypt==4.2.1 在 PyPI 有 manylinux wheel，pip install 不触发本地编译。
# - pip 升级 setuptools wheel 已在 pip install 前完成。
#
# 保留：locales（zh_CN.UTF-8 给日志/导出）、tini（PID 1 信号处理，让 uvicorn 优雅关闭）。

FROM python:3.12-slim

# locales：生成 zh_CN.UTF-8 给 structlog 日志和导出文件名
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        locales \
        tini \
 && sed -i '/zh_CN.UTF-8/s/^# //g' /etc/locale.gen \
 && locale-gen \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# pip 国内镜像（阿里云）：海外构建可换成官方 https://pypi.org/simple/
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ \
 && pip config set global.trusted-host mirrors.aliyun.com \
 && pip config set global.timeout 120 \
 && pip config set install.retries 5

ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/xiaozhi-fde-talk

# 单独拷贝 lockfile，最大化层缓存命中：只改业务代码不影响 pip install 层。
COPY backend/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
 && pip install --no-cache-dir -r requirements.txt --default-timeout=120 --retries 5