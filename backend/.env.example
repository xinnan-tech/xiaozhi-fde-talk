# .env 落点：本项目统一放 backend/data/.env，Docker 挂 data/ 卷即用。
# 首次启动：在 backend/ 下执行 cp .env.example data/.env，然后按需改下面各项。

# 服务监听
HOST=0.0.0.0
PORT=8000

# 日志
LOG_LEVEL=INFO
LOG_FILE=

# 数据库（默认 SQLite，路径在 backend/data/xiaozhi_fde_talk.db）。
# 留空走默认；要切 MySQL/PG 取消下面那行注释，填入标准 URL：
#   mysql+aiomysql://user:pass@host:3306/dbname
#   postgresql+asyncpg://user:pass@host:5432/dbname
DB_ECHO=false

# 部署模式
ENV=dev                            # dev / test / prod
SERVE_FRONTEND=true                # true=托管前端 SPA；false=纯 API

# JWT 算法（密钥由系统启动时自动生成并写入 DB，无需配置）
JWT_ALGORITHM=HS256

# CORS 允许的来源（逗号分隔）。
# dev 环境留空也能跑，默认放行 http://localhost:5173。
# 部署到公网前必须显式列出域名（如 https://talk.your-company.com），
# 留空启动会直接报错，避免公网意外放行所有来源。
# CORS_ORIGINS=
